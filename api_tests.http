# Создаем книгу
POST http://localhost:8000/api/v1/books/ HTTP/1.1
Content-Type: application/json

{
    "title": "Dasha",
    "author": "Super",
    "count_pages": 300,
    "year": 2020,
    "seller_id": 3
}

###

# Получаем список книг
GET http://localhost:8000/api/v1/books/ HTTP/1.1

###

# Получаем одну книгу по ее ИД
GET http://localhost:8000/api/v1/books/5 HTTP/1.1

###

# Удаляем книгу
DELETE http://localhost:8000/api/v1/books/4 HTTP/1.1

###

# Обновляем поля в данных о книге
PUT http://localhost:8000/api/v1/books/7 HTTP/1.1
Content-Type: application/json

{
    "id": 6,
    "title": "Misery",
    "author": "Robert Martin",
    "year": 2022,
    "pages": 310,
    "seller_id": 5
}

###

# Создаем продавца

POST http://localhost:8000/api/v1/sellers/ HTTP/1.1
Content-Type: application/json

{
    "first_name": "Ivan",
    "last_name": "Komarov",
    "email": "komar@gmail.com",
    "password": "12345678qwe"
}

###

# Получаем список всех продавцов
GET http://localhost:8000/api/v1/sellers/ HTTP/1.1

###

# Получаем информацию о продавце по id
GET http://localhost:8000/api/v1/sellers/3 HTTP/1.1

###

# Удаляем продавца по id
DELETE http://localhost:8000/api/v1/sellers/2 HTTP/1.1

###

# Меняем значение продавца по id

PUT http://localhost:8000/api/v1/sellers/1 HTTP/1.1
Content-Type: application/json

{
    "id": 4,
    "first_name": "Ivan",
    "last_name": "Komarov",
    "email": "komar@gmail.com"
}